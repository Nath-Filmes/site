{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/casamento", "destination": "/casamento.html" }
  ],
  "redirects": [
    { "source": "/README.md", "destination": "/", "permanent": false },
    { "source": "/CONTEUDO-PENDENTE.md", "destination": "/", "permanent": false },
    { "source": "/LISTA-DE-ARQUIVOS.md", "destination": "/", "permanent": false },
    { "source": "/abrir-site-local.bat", "destination": "/", "permanent": false },
    { "source": "/tools/:path*", "destination": "/", "permanent": false },
    { "source": "/assets/img/guardadas/:path*", "destination": "/", "permanent": false },
    { "source": "/assets/:pasta/LEIA-ME.txt", "destination": "/", "permanent": false },
    { "source": "/.gitignore", "destination": "/", "permanent": false },
    { "source": "/.gitattributes", "destination": "/", "permanent": false },
    { "source": "/.vercelignore", "destination": "/", "permanent": false },
    { "source": "/vercel.json", "destination": "/", "permanent": false },
    { "source": "/package.json", "destination": "/", "permanent": false },
    { "source": "/package-lock.json", "destination": "/", "permanent": false },
    { "source": "/node_modules/:path*", "destination": "/", "permanent": false },
    { "source": "/.env", "destination": "/", "permanent": false }
  ]
}
